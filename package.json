{
  "name": "dsh-resume-job-search",
  "version": "0.2.0",
  "private": false,
  "description": "DSH（DeepSeek Harness）插件：简历编写与求职分析。以技能提供方注册 8 个 SKILL.md，覆盖岗位情报→匹配度评估→简历改写→求职信→面试准备→投递台账。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-skill",
    "resume",
    "cv",
    "cover-letter",
    "job-search",
    "interview-prep",
    "简历",
    "求职"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyn-haha/dsh-resume-job-search.git"
  },
  "homepage": "https://github.com/xyn-haha/dsh-resume-job-search",
  "bugs": {
    "url": "https://github.com/xyn-haha/dsh-resume-job-search/issues"
  },
  "files": [
    "lib",
    "skills",
    "templates",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "privacy": "node scripts/privacy-scan.mjs",
    "test": "node scripts/validate-skills.mjs && node scripts/privacy-scan.mjs && node test/provider.test.mjs",
    "test:integration": "node test/integration.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "skills": {
      "dir": "skills"
    },
    "displayName": "简历编写与求职分析"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
